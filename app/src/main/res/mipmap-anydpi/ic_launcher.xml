<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback for API 24/25, which have no adaptive icons. No mask is applied there, so no safe
     zone is needed and the motif fills the viewport (r=47 instead of 32.5). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Chassis, with the grey rim of the original -->
    <path
        android:pathData="M54,7 a47,47 0 1,0 0,94 a47,47 0 1,0 0,-94 Z"
        android:fillColor="#000000"
        android:strokeColor="#666666"
        android:strokeWidth="2.9" />

    <!-- Surround: annulus between r=35.1 and r=18.65 -->
    <path
        android:fillType="evenOdd"
        android:fillColor="#FF0000"
        android:pathData="M54,18.9 a35.1,35.1 0 1,0 0,70.2 a35.1,35.1 0 1,0 0,-70.2 Z
                          M54,35.35 a18.65,18.65 0 1,0 0,37.3 a18.65,18.65 0 1,0 0,-37.3 Z" />

    <!-- Dome -->
    <path android:pathData="M54,35.35 a18.65,18.65 0 1,0 0,37.3 a18.65,18.65 0 1,0 0,-37.3 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="47"
                android:centerY="47"
                android:gradientRadius="24"
                android:startColor="#3A3A3A"
                android:endColor="#000000" />
        </aapt:attr>
    </path>

</vector>
