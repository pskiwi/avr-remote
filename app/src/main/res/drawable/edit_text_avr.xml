<?xml version="1.0" encoding="utf-8"?>
<!-- Ersetzt den weissen pre-Holo-Kasten mit orangem Fokusrahmen, den die Plattform
     ueber ?attr/editTextBackground liefert. Der Material-Ersatz war keiner:
     Widget.Material.EditText ist ein leerer Alias von Widget.EditText und aendert
     nichts, die Optik haengt allein an diesem Attribut. Dunkles Feld mit duennem
     Rand, im Fokus in der Akzentfarbe. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape>
            <solid android:color="#1A1A1A" />
            <stroke
                android:width="2dp"
                android:color="@color/accent" />
            <corners android:radius="2dp" />
            <padding
                android:left="8dp"
                android:top="6dp"
                android:right="8dp"
                android:bottom="6dp" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#1A1A1A" />
            <stroke
                android:width="1dp"
                android:color="#666666" />
            <corners android:radius="2dp" />
            <padding
                android:left="8dp"
                android:top="6dp"
                android:right="8dp"
                android:bottom="6dp" />
        </shape>
    </item>

</selector>
