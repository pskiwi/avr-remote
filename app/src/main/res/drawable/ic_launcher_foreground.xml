<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: the speaker driver of the old 63x63 icon.png, redrawn as a vector.
     Centre 54,54; the chassis has r=32.5, so the motif stays inside the 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Chassis, with the grey rim of the original -->
    <path
        android:pathData="M54,21.5 a32.5,32.5 0 1,0 0,65 a32.5,32.5 0 1,0 0,-65 Z"
        android:fillColor="#000000"
        android:strokeColor="#666666"
        android:strokeWidth="2" />

    <!-- Surround: annulus between r=24.6 and r=13.4 -->
    <path
        android:fillType="evenOdd"
        android:fillColor="#FF0000"
        android:pathData="M54,29.4 a24.6,24.6 0 1,0 0,49.2 a24.6,24.6 0 1,0 0,-49.2 Z
                          M54,40.6 a13.4,13.4 0 1,0 0,26.8 a13.4,13.4 0 1,0 0,-26.8 Z" />

    <!-- Dome -->
    <path android:pathData="M54,40.6 a13.4,13.4 0 1,0 0,26.8 a13.4,13.4 0 1,0 0,-26.8 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="49"
                android:centerY="49"
                android:gradientRadius="17"
                android:startColor="#3A3A3A"
                android:endColor="#000000" />
        </aapt:attr>
    </path>

</vector>
